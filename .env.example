# DataShare — variables d'environnement
#
# Copier en .env puis ajuster :   cp .env.example .env
#
# Ce fichier est versionné, .env ne l'est jamais. Aucun secret réel ici : les
# valeurs ci-dessous sont des valeurs de développement local, à remplacer en
# production.

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=datashare
POSTGRES_PASSWORD=datashare_dev_only
POSTGRES_DB=datashare

# ── Authentification ─────────────────────────────────────────────────────────
# À remplacer par une valeur aléatoire longue. Génération :
#   openssl rand -base64 48
JWT_SECRET=remplacer_par_une_valeur_aleatoire_longue

# ── Stockage objet ───────────────────────────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=datashare
S3_ACCESS_KEY=datashare_dev
S3_SECRET_KEY=datashare_dev_secret

# L'API joint MinIO par le réseau Docker interne (http://minio:9000, codé dans
# docker-compose.yml). Mais les URLs PRÉ-SIGNÉES sont consommées par le
# NAVIGATEUR, qui ne sait pas résoudre `minio` : elles doivent donc porter un
# hôte joignable depuis l'hôte.
#
# C'est la variable la plus facile à oublier, et son oubli casse tous les
# téléversements avec une erreur réseau opaque côté navigateur.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ── Application ──────────────────────────────────────────────────────────────
# Origine publique du front. Sert à deux choses : la politique CORS du bucket
# (voir scripts/init-bucket.sh) et la construction des liens de téléchargement.
PUBLIC_APP_ORIGIN=http://localhost:8080
